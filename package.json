    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sass": "^1.81.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
